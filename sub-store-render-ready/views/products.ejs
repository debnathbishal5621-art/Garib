<!doctype html><html><head><title>SUB STORE — Products</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/admin">SUB STORE</a><a href="/admin/logout">Logout</a></nav><main class="wrap"><div class="panel"><h1>Products & Prices</h1><form method="post" action="/admin/products/save"><div class="row"><div><label>Name</label><input class="input" name="name" required></div><div><label>Category</label><input class="input" name="category"></div></div><div class="row"><div><label>Price ₹</label><input class="input" type="number" name="price" required></div><div><label>Duration</label><input class="input" name="duration"></div></div><label>Description</label><textarea name="description"></textarea><label><input type="checkbox" name="active" checked> Active</label> <label><input type="checkbox" name="featured"> Featured</label><br><br><button class="btn">Add Product</button></form></div><div class="panel" style="margin-top:20px"><table class="table"><tr><th>Product</th><th>Price</th><th>Duration</th><th>Edit</th></tr><%products.forEach(p=>{%><tr><td><%=p.name%></td><td>₹<%=p.price%></td><td><%=p.duration%></td><td><details><summary>Edit</summary><form method="post" action="/admin/products/save"><input type="hidden" name="id" value="<%=p.id%>"><input class="input" name="name" value="<%=p.name%>"><input class="input" name="category" value="<%=p.category%>"><input class="input" type="number" name="price" value="<%=p.price%>"><input class="input" name="duration" value="<%=p.duration%>"><textarea name="description"><%=p.description||''%></textarea><label><input type="checkbox" name="active" <%=p.active?'checked':''%>> Active</label> <label><input type="checkbox" name="featured" <%=p.featured?'checked':''%>> Featured</label><br><br><button class="btn">Update</button></form><%if(admin.role==='owner'){%><form method="post" action="/admin/products/delete" style="margin-top:8px"><input type="hidden" name="id" value="<%=p.id%>"><button class="btn danger">Delete</button></form><%}%></details></td></tr><%})%></table></div></main></body></html>
