<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SUB STORE — OTT & AI Subscriptions</title><link rel="icon" href="/logo.png"><link rel="stylesheet" href="/style.css"></head><body>
<nav class="nav"><a class="brand" href="/"><img src="/logo.png" alt="SUB STORE"><span>SUB STORE</span></a><div class="nav-actions"><a href="#faq">FAQ</a><a href="#reviews">Reviews</a><a class="admin-link" href="/admin/login">Admin</a></div></nav>
<main class="wrap">
<section class="hero"><div><span class="eyebrow">OTT • AI • PREMIUM SERVICES</span><h1>Premium subscriptions at simple prices.</h1><p class="muted">Choose the service you want, copy the exact service name, and contact us directly on WhatsApp.</p><a class="wa-main" href="https://wa.me/918275343925?text=Hi%20SUB%20STORE%2C%20I%20want%20to%20buy%20a%20subscription.%20Please%20help%20me." target="_blank" rel="noopener">💬 Contact on WhatsApp</a></div><div class="hero-logo"><img src="/logo.png" alt="SUB STORE logo"></div></section>
<div class="buy-note"><strong>How to buy:</strong> Copy the exact service name below → open WhatsApp → send the service name to <strong>8275343925</strong>.</div>
<div class="grid"><% products.forEach(p=>{ %><article class="card"><div class="card-top"><span class="tag"><%=p.category%></span><% if(p.featured){ %><span class="featured">★ Featured</span><% } %></div><h2><%=p.name%></h2><p class="muted"><%=p.duration||'Subscription plan'%></p><div class="price">₹<%=p.price%></div><div class="service-copy"><span><%=p.name%></span><button type="button" onclick='copyService(this,<%- JSON.stringify(p.name) %>)'>Copy</button></div><a class="btn wa" href="https://wa.me/918275343925?text=<%=encodeURIComponent('Hi SUB STORE, I want to buy: '+p.name)%>" target="_blank" rel="noopener">Buy on WhatsApp</a></article><% }) %></div>

<section id="reviews" class="section"><div class="section-head"><div><span class="eyebrow">CUSTOMER FEEDBACK</span><h2>What our customers say</h2><p class="muted">Real reviews submitted by customers. New reviews are checked before they appear publicly.</p></div></div>
<div class="review-layout"><div class="review-list"><% if(reviews.length){ reviews.forEach(r=>{ %><article class="review-card"><div class="review-top"><strong><%=r.name%></strong><span class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></span></div><p><%=r.message%></p></article><% }) } else { %><div class="empty-review">No reviews yet. Be the first customer to leave one!</div><% } %></div>
<form class="panel review-form" id="reviewForm"><h3>Leave a review</h3><label>Your name<input class="input" name="name" maxlength="80" required></label><label>Rating<select class="input" name="rating" required><option value="5">★★★★★ — Excellent</option><option value="4">★★★★☆ — Good</option><option value="3">★★★☆☆ — Okay</option><option value="2">★★☆☆☆ — Poor</option><option value="1">★☆☆☆☆ — Bad</option></select></label><label>Your review<textarea class="input" name="message" rows="5" maxlength="500" required placeholder="Tell us about your experience..."></textarea></label><button class="btn" type="submit">Submit review</button><p id="reviewMsg" class="form-msg"></p></form></div></section>

<section id="faq" class="section"><div class="section-head"><div><span class="eyebrow">HELP CENTER</span><h2>Frequently asked questions</h2><p class="muted">Quick answers before you order.</p></div></div><div class="faq-list"><details open><summary>How do I place an order?</summary><p>Choose a service, copy its exact name, then click <strong>Buy on WhatsApp</strong>. Send the service name to <strong>8275343925</strong> and our team will guide you.</p></details><details><summary>What payment methods are available?</summary><p>Payment details are provided through WhatsApp when you place your order. Please confirm the current payment method and amount with our team before paying.</p></details><details><summary>How long does activation take?</summary><p>Activation time can vary by service and availability. Our team will tell you the expected activation time when you order.</p></details><details><summary>Can I ask about a service that is not listed?</summary><p>Yes. Message us on WhatsApp at <strong>8275343925</strong> and ask about the service you need.</p></details><details><summary>What should I do if I have a problem after purchase?</summary><p>Contact us on WhatsApp with your order details. Please keep your payment/order information available so we can help you faster.</p></details></div></section>
</main><footer>SUB STORE • Contact: 8275343925</footer>
<script>
async function copyService(btn,name){try{await navigator.clipboard.writeText(name);const old=btn.textContent;btn.textContent='Copied!';setTimeout(()=>btn.textContent=old,1200)}catch(e){alert('Service name: '+name)}}
document.getElementById('reviewForm').addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,msg=document.getElementById('reviewMsg');msg.textContent='Submitting...';try{const r=await fetch('/api/reviews',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(f)))});const data=await r.json();if(!r.ok)throw new Error(data.error||'Could not submit');msg.textContent=data.message;f.reset()}catch(err){msg.textContent=err.message}});
</script></body></html>
