<!doctype html><html><head><title>Staff</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/admin">SUB STORE</a><a href="/admin/logout">Logout</a></nav><main class="wrap"><div class="panel"><h1>Staff Accounts</h1><form method="post" action="/admin/staff/save"><div class="row"><input class="input" name="username" placeholder="Username" required><input class="input" name="password" placeholder="Password" required></div><select name="role"><option value="staff">Staff</option><option value="owner">Owner</option></select><button class="btn">Create Account</button></form></div><div class="panel" style="margin-top:20px"><table class="table"><tr><th>Username</th><th>Role</th><th>Action</th></tr><%staff.forEach(s=>{%><tr><td><%=s.username%></td><td><%=s.role%></td><td><%if(s.id!==admin.id){%><form method="post" action="/admin/staff/delete"><input type="hidden" name="id" value="<%=s.id%>"><button class="btn danger">Remove</button></form><%}%></td></tr><%})%></table></div></main></body></html>
