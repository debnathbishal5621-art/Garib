<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=p.name%> — SUB STORE</title><link rel="icon" href="/logo.png"><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/"><img src="/logo.png" alt="SUB STORE"><span>SUB STORE</span></a></nav><main class="wrap"><div class="panel product-panel"><span class="tag"><%=p.category%></span><h1><%=p.name%></h1><div class="price">₹<%=p.price%></div><p><%=p.duration||'Subscription plan'%></p><p class="muted"><%=p.description||'Premium digital subscription service.'%></p><div class="buy-note"><strong>To buy:</strong> copy the service name and contact <strong>8275343925</strong> on WhatsApp.</div><div class="service-copy large"><span><%=p.name%></span><button type="button" onclick="copyService(this,'<%=p.name.replace(/'/g,"\\'")%>')">Copy Service Name</button></div><a class="btn wa" href="https://wa.me/918275343925?text=<%=encodeURIComponent('Hi SUB STORE, I want to buy: '+p.name)%>" target="_blank" rel="noopener">💬 Open WhatsApp</a><br><br><a class="btn alt" href="/">← Back to Store</a></div></main><script>async function copyService(btn,name){try{await navigator.clipboard.writeText(name);btn.textContent='Copied!';setTimeout(()=>btn.textContent='Copy Service Name',1200)}catch(e){alert('Service name: '+name)}}</script></body></html>
