<!doctype html><html><head><title>SUB STORE — Admin Panel</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><div class="brand">SUB STORE — Admin Panel</div><div><a href="/admin/products">Products</a> &nbsp; <%if(admin.role==='owner'){%><a href="/admin/staff">Staff</a> &nbsp;<%}%><a href="/admin/logout">Logout</a></div></nav><main class="wrap"><div class="stats"><div class="panel stat">Products<b><%=stats.products%></b></div><div class="panel stat">Orders<b><%=stats.orders%></b></div><div class="panel stat">Pending<b><%=stats.pending%></b></div><div class="panel stat">Paid Revenue<b>₹<%=stats.revenue%></b></div></div><div class="panel" style="margin-top:20px"><h2>Recent Orders</h2><table class="table"><tr><th>Order</th><th>Product</th><th>Customer</th><th>Status</th><th>Action</th></tr><%orders.forEach(o=>{%><tr><td><%=o.order_no%></td><td><%=o.product_name%></td><td><%=o.customer_name%><br><%=o.customer_contact%></td><td><%=o.status%></td><td><form method="post" action="/admin/orders/status"><input type="hidden" name="id" value="<%=o.id%>"><select name="status"><option>PENDING</option><option>PAID</option><option>DELIVERED</option><option>CANCELLED</option></select><button class="btn">Save</button></form></td></tr><%})%></table><div class="panel" style="margin-top:20px" id="reviews"><div class="top"><h2>Customer Reviews</h2><span class="muted">Approve reviews before they appear on the store.</span></div><table class="table"><tr><th>Name</th><th>Rating</th><th>Review</th><th>Status</th><th>Action</th></tr><% reviews.forEach(r=>{%><tr><td><%=r.name%></td><td><%= '★'.repeat(r.rating) %></td><td><%=r.message%></td><td><%=r.status%></td><td><form method="post" action="/admin/reviews/status" style="display:inline"><input type="hidden" name="id" value="<%=r.id%>"><input type="hidden" name="status" value="<%=r.status==='APPROVED'?'PENDING':'APPROVED'%>"><button class="btn"><%=r.status==='APPROVED'?'Hide':'Approve'%></button></form> <% if(admin.role==='owner'){ %><form method="post" action="/admin/reviews/delete" style="display:inline"><input type="hidden" name="id" value="<%=r.id%>"><button class="btn danger">Delete</button></form><% } %></td></tr><%})%></table></div></div></main></body></html>
