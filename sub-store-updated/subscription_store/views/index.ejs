<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SUB STORE — OTT & AI Subscriptions</title><link rel="icon" href="/logo.png"><link rel="stylesheet" href="/style.css"></head><body>
<nav class="nav"><a class="brand" href="/"><img src="/logo.png" alt="SUB STORE"><span>SUB STORE</span></a><a class="admin-link" href="/admin/login">Admin</a></nav>
<main class="wrap">
<section class="hero"><div><span class="eyebrow">OTT • AI • PREMIUM SERVICES</span><h1>Premium subscriptions at simple prices.</h1><p class="muted">Choose the service you want, copy the service name, and contact us directly on WhatsApp.</p><a class="wa-main" href="https://wa.me/918275343925?text=Hi%20SUB%20STORE%2C%20I%20want%20to%20buy%20a%20subscription.%20Please%20help%20me." target="_blank" rel="noopener">💬 Contact on WhatsApp</a></div><div class="hero-logo"><img src="/logo.png" alt="SUB STORE logo"></div></section>
<div class="buy-note"><strong>How to buy:</strong> Copy the exact service name below → open WhatsApp → send the service name to <strong>8275343925</strong>.</div>
<div class="grid"><% products.forEach(p=>{ %><article class="card"><div class="card-top"><span class="tag"><%=p.category%></span><% if(p.featured){ %><span class="featured">★ Featured</span><% } %></div><h2><%=p.name%></h2><p class="muted"><%=p.duration||'Subscription plan'%></p><div class="price">₹<%=p.price%></div><div class="service-copy"><span><%=p.name%></span><button type="button" onclick="copyService(this,'<%=p.name.replace(/'/g,"\\'")%>')">Copy</button></div><a class="btn wa" href="https://wa.me/918275343925?text=<%=encodeURIComponent('Hi SUB STORE, I want to buy: '+p.name)%>" target="_blank" rel="noopener">Buy on WhatsApp</a></article><% }) %></div>
</main><footer>SUB STORE • Contact: 8275343925</footer>
<script>async function copyService(btn,name){try{await navigator.clipboard.writeText(name);const old=btn.textContent;btn.textContent='Copied!';setTimeout(()=>btn.textContent=old,1200)}catch(e){alert('Service name: '+name)}}</script>
</body></html>
