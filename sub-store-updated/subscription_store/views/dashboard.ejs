<!doctype html><html><head><title>SUB STORE — Admin Panel</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><div class="brand">SUB STORE — Admin Panel</div><div><a href="/admin/products">Products</a> &nbsp; <%if(admin.role==='owner'){%><a href="/admin/staff">Staff</a> &nbsp;<%}%><a href="/admin/logout">Logout</a></div></nav><main class="wrap"><div class="stats"><div class="panel stat">Products<b><%=stats.products%></b></div><div class="panel stat">Orders<b><%=stats.orders%></b></div><div class="panel stat">Pending<b><%=stats.pending%></b></div><div class="panel stat">Paid Revenue<b>₹<%=stats.revenue%></b></div></div><div class="panel" style="margin-top:20px"><h2>Recent Orders</h2><table class="table"><tr><th>Order</th><th>Product</th><th>Customer</th><th>Status</th><th>Action</th></tr><%orders.forEach(o=>{%><tr><td><%=o.order_no%></td><td><%=o.product_name%></td><td><%=o.customer_name%><br><%=o.customer_contact%></td><td><%=o.status%></td><td><form method="post" action="/admin/orders/status"><input type="hidden" name="id" value="<%=o.id%>"><select name="status"><option>PENDING</option><option>PAID</option><option>DELIVERED</option><option>CANCELLED</option></select><button class="btn">Save</button></form></td></tr><%})%></table></div></main></body></html>
